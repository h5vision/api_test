{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: start",
      "type": "process",
      "command": "${workspaceFolder}\\..\\.venv\\Scripts\\python.exe",
      "args": ["${workspaceFolder}\\main.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running|Started reloader process",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "frontend: compile",
      "type": "npm",
      "script": "compile",
      "path": "frontend",
      "problemMatcher": "$tsc"
    }
  ]
}

