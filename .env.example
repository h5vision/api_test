NVIDIA_API_KEY=replace-with-your-nvidia-api-key

AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-70b-instruct
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2

EMBEDDING_PROVIDER=nvidia
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

VECTOR_DB_PROVIDER=sqlite
VECTOR_DB_PATH=./data/vector_store.sqlite3

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vision
POSTGRES_USER=vision
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_CONNECT_TIMEOUT_SECONDS=3

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=vscode-webview://*,http://127.0.0.1:*,http://localhost:*,http://192.168.0.7:8000,https://dashboard.blakeedenparker.cloud,https://index.blakeedenparker.cloud
REQUEST_TIMEOUT_SECONDS=60
ALLOW_LOCAL_FALLBACK=true
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
