NVIDIA_API_KEY=replace-with-your-nvidia-api-key
GROQ_API_KEY=replace-with-your-groq-api-key

# Local-only Admin UI preview port. 4173 may be reserved on Windows.
ADMIN_PREVIEW_PORT=4180

AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional preferred model. /v1/models discovers the live Provider catalog;
# when this value is blank or unavailable, the first discovered model is used.
AI_MODEL=meta/llama-3.1-70b-instruct
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
# Low-memory sLLM prompt budgets. Ollama receives AI_CONTEXT_WINDOW_TOKENS as num_ctx.
AI_CONTEXT_WINDOW_TOKENS=32768
AI_QUESTION_MAX_CHARS=20000
AI_HISTORY_MAX_CHARS=12000
AI_FRONTEND_CONTEXT_MAX_CHARS=24000

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_PUBLIC_MODEL_ID=groq-default

EMBEDDING_PROVIDER=ollama
EMBEDDING_DEPLOYMENT=local
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_MODEL_ID=bge-m3:latest
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_KEEP_ALIVE=10m
EMBEDDING_TIMEOUT_SECONDS=300

VECTOR_DB_PROVIDER=sqlite
VECTOR_DB_PATH=./data/vector_store.sqlite3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-a-long-random-qdrant-key
QDRANT_COLLECTION=vision_bge_m3_v1
INDEX_VERSION=bge-m3-v1
RAG_LAB_BASE_URL=http://192.168.0.12:8200
RAG_LAB_TOKEN=
RAG_LAB_TIMEOUT_SECONDS=60

BACKENDAI_BASE_URL=http://192.168.0.12:11434
BACKENDAI_API_KEY=
BACKENDAI_MODEL=gemma3:4b
BACKENDAI_PUBLIC_MODEL_ID=backendai-default
NVIDIA_PUBLIC_MODEL_ID=nvidia-default
# Fernet key used only to encrypt administrator-entered Provider API keys.
# Docker Compose creates this as a persistent runtime secret automatically.
# For native execution, generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_PROVIDER_MASTER_KEY=
DEFAULT_MODEL_ID=backendai-default
ALLOW_CLOUD_FALLBACK=false

FRONTEND_HOST=192.168.0.7
FRONTEND_PORT=8888

PROJECT_DB_LOCAL_ROOT=C:/Users/PC2412/Documents/HancomAI5
VECTOR_DB_LOCAL_ROOT=C:/Users/PC2412/Documents/HancomAI5/Vision/data/vector-databases
OFFLINE_EMBEDDING_ROOT=./embedding-results
UPLOAD_ROOT=./data/uploads
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_SESSION_TTL_HOURS=72
MAX_INDEXABLE_FILE_BYTES=16777216

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vision
POSTGRES_USER=vision
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_CONNECT_TIMEOUT_SECONDS=3

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_DB=0
TASK_QUEUE_NAME=vision:tasks:indexing

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=vscode-webview://*,http://127.0.0.1:*,http://localhost:*,http://192.168.0.7,http://192.168.0.7:8000
# FastAPI가 X-Forwarded-For를 신뢰할 Docker edge 네트워크만 지정한다.
TRUSTED_PROXY_HOSTS=172.30.0.0/24
REQUEST_TIMEOUT_SECONDS=60
ALLOW_LOCAL_FALLBACK=false
CHUNK_SIZE=1600
CHUNK_OVERLAP=200
# Optional alias=canonical pairs used when an older Frontend hardcodes a
# non-canonical project_id. Multiple pairs may be comma-separated.
# Example: FastAPI=h5vision/fest-api
PROJECT_ID_ALIASES=
