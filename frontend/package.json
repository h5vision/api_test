{
  "name": "hancomai5-vscode-ai-assistant",
  "displayName": "HancomAI5 VS Code AI Assistant",
  "description": "FastAPI, NVIDIA NIM, and VectorDB powered project assistant.",
  "version": "0.1.0",
  "publisher": "hancomai5-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onCommand:hancomAi.openChat",
    "onCommand:hancomAi.indexCurrentFile",
    "onCommand:hancomAi.checkBackend"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hancomAi.openChat",
        "title": "Hancom AI: 채팅 열기"
      },
      {
        "command": "hancomAi.indexCurrentFile",
        "title": "Hancom AI: 현재 파일 인덱싱"
      },
      {
        "command": "hancomAi.checkBackend",
        "title": "Hancom AI: 백엔드 연결 확인"
      }
    ],
    "configuration": {
      "title": "Hancom AI Assistant",
      "properties": {
        "hancomAi.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "FastAPI 백엔드 기본 URL"
        },
        "hancomAi.projectId": {
          "type": "string",
          "default": "",
          "description": "VectorDB 프로젝트 ID. 비어 있으면 워크스페이스 폴더명을 사용합니다."
        },
        "hancomAi.topK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "답변 생성에 사용할 검색 결과 수"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}

