    Set-Location -LiteralPath $ProjectRoot


    Write-Host ""
    Write-Host "==> Python compile" -ForegroundColor Cyan
    & $Python -m compileall -q backend tests
    if ($LASTEXITCODE -ne 0) { throw "Python compile failed" }


    Write-Host ""
    Write-Host "==> Snapshot import tests" -ForegroundColor Cyan
    & $Python -m pytest `
        tests/test_admin_snapshot_import.py `
        tests/test_admin_snapshot_api.py `
        tests/test_admin_snapshot_frontend_contract.py `
        -q
    if ($LASTEXITCODE -ne 0) { throw "Snapshot import tests failed" }


    Write-Host ""
    Write-Host "==> Admin strict TypeScript and Vite build" -ForegroundColor Cyan
    & npm --prefix admin run build
    if ($LASTEXITCODE -ne 0) { throw "Admin frontend build failed" }
}


Write-Host ""
Write-Host "PASS: Admin GitHub URL repository and Snapshot import is implemented." -ForegroundColor Green