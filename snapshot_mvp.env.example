# GitHub Commit Snapshot MVP is disabled by default.
SNAPSHOT_CONTROL_PLANE_ENABLED=false


# Use at least 32 bytes of random data. Send it as X-Vision-Snapshot-Token.
SNAPSHOT_MVP_TOKEN=replace-with-a-long-random-secret


# Single-tenant MVP. The API never accepts tenant_id from request bodies or queries.
SNAPSHOT_TENANT_ID=vision-default


# Public repositories explicitly approved for this MVP.
SNAPSHOT_ALLOWED_REPOSITORIES=h5vision/api_test


# Anonymous public GitHub API settings. No GITHUB_TOKEN is used by the adapter.
SNAPSHOT_GITHUB_TIMEOUT_SECONDS=20
SNAPSHOT_MAX_FILE_BYTES=2097152


# Optional live verification. This calls the public GitHub API.
GITHUB_INTEGRATION_TESTS=0
